  "fiches": {
    "servo": {
      "titre": "Le servomoteur",
      "lignes": [
        "Un servomoteur est un moteur qui se place à un angle précis, entre 0° et 180°.",
        "C’est un actionneur : il agit sur le monde réel. Ici, il incline le plateau du labyrinthe.",
        "90° : plateau à plat. Moins de 90° : il penche d’un côté. Plus de 90° : de l’autre côté.",
        "Le labyrinthe a deux servomoteurs : D5 pour l’axe X (gauche – droite), D6 pour l’axe Y (haut – bas)."
      ],
      "schema": {
        "type": "servo"
      }
    },
    "demarrage-boucle": {
      "titre": "« Au démarrage » et « Répéter indéfiniment »",
      "lignes": [
        "« Au démarrage » : les blocs s’exécutent une seule fois, quand la carte s’allume.",
        "« Répéter indéfiniment » : les blocs s’exécutent de haut en bas, puis tout recommence, sans fin.",
        "Pour suivre le joystick en permanence, il faut « Répéter indéfiniment »."
      ],
      "schema": {
        "type": "deroulement"
      }
    },
    "joystick": {
      "titre": "Le joystick",
      "lignes": [
        "Le joystick est un capteur : il mesure la position que tu lui donnes avec le doigt.",
        "Axe X (gauche – droite) sur A0, axe Y (bas – haut) sur A1 : ce sont des broches analogiques, elles donnent une valeur de 0 à 1023.",
        "Au centre, la valeur est d’environ 512. Tout d’un côté : 0. Tout de l’autre : 1023.",
        "Le bouton du joystick (SW, broche D4) s’enfonce en appuyant sur le manche."
      ]
    },
    "reetalonner": {
      "titre": "Ré-étalonner",
      "lignes": [
        "Le joystick donne une valeur de 0 à 1023, mais un servomoteur attend un angle de 0° à 180°.",
        "« ré-étalonner » passe d’une échelle à l’autre en gardant les proportions : le milieu reste au milieu (512 → 90°).",
        "depuis (0, 1023) vers (0, 180) : 0 → 0°, 512 → 90°, 1023 → 180°.",
        "Inverser les deux nombres de « depuis » inverse le sens du mouvement.",
        "Réduire l’écart entre les deux nombres de « vers » réduit l’inclinaison du plateau : (60, 120) est plus doux que (0, 180)."
      ]
    }
  },
