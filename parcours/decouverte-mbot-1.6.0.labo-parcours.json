      "blocsAutorises": [
        "mbot_deplacer",
        "mbot_deplacer_pendant",
        "mbot_arreter",
        "attendre"
      ],
      "blocsDepart": null,
      "scenarios": [
        {
          "nom": "Le robot avance 2 s puis s’arrête",
          "etapes": [
            {
              "verifier": {
                "moteur gauche": 50,
                "moteur droit": 50
              }
            },
            {
              "attendre": 1.5
            },
            {
              "verifier": {
                "moteur gauche": 0,
                "moteur droit": 0
              },
              "delai": 0.6
            },
            {
              "stable": {
                "moteur gauche": 0,
                "moteur droit": 0
              },
              "duree": 2
            }
          ]
        }
      ],
      "indices": [
        "Le robot avance, on attend 2 secondes, puis on arrête les moteurs. Tout se passe une seule fois.",
        "Blocs : « avancer à la vitesse … pendant … s » dans « Au démarrage »."
      ],
      "solutionReference": {
        "demarrage": [
          {
